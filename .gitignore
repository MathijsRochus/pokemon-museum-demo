# macOS
.DS_Store

# Local backups kept while the art was being rewritten — not part of the game
*.bak

# Leftover source images from before the artwork became procedural — floor.png
# and player.png are unused, since game.js draws every texture at runtime. The
# museum's pixel logo is the exception: the loading and end screens load it, so
# it has to ship.
assets/*
!assets/Pixel-Logo-41-frames-transparent.gif

# Test bundles, written by tests/harness.mjs
tests/_bundle_*.mjs
